# ─── MongoDB ────────────────────────────────────────────────────────────────
# For local dev without Docker (MongoDB replica set on localhost)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0

# For Docker Compose (uses internal service name)
# MONGO_URI=mongodb://equicity:equicity_secret@mongo:27017/equicity?replicaSet=rs0&authSource=admin

DB_NAME=equicity

# ─── Alert Thresholds ────────────────────────────────────────────────────────
ALERT_DRI_THRESHOLD=75.0
ALERT_DRI_RESET=70.0
ALERT_COOLDOWN_DAYS=14

# ─── Frontend ────────────────────────────────────────────────────────────────
# Get your free token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Backend API URL (used by Next.js at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Docker Compose ──────────────────────────────────────────────────────────
MAPBOX_TOKEN=pk.your_mapbox_public_token_here

